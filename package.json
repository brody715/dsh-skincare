{
  "name": "@brody715/dsh-skincare",
  "version": "0.3.1",
  "description": "有出处的护肤专家与学习能力包：按需检索中文知识、核对来源，复用宿主助手与记忆，可选 dsh-go 入口",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skill/*": "./skill/*",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/index.js",
    "lib/skill.js",
    "lib/panel.js",
    "skill/SKILL.md",
    "skill/knowledge-map.md",
    "skill/references",
    "skill/agents",
    "skill/scripts/lookup.mjs",
    "skill/scripts/legacy-profile.mjs",
    "skill/scripts/read-bounded.mjs",
    "skill/sources/index.jsonl",
    "skill/sources/topics.json",
    "cordis.patch.yml",
    "icon.svg",
    "docs/design.md",
    "docs/panel.md",
    "docs/writing-guide.md",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "skin-care",
    "dsh-go",
    "dsh-bundle"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brody715/dsh-skincare.git",
    "directory": "."
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "护肤",
      "en": "Skin Care"
    },
    "icon": "heart",
    "contributes": {
      "panels": [
        {
          "id": "skin-care-panel",
          "title": {
            "zh": "护肤",
            "en": "Skin Care"
          },
          "icon": "heart",
          "placement": [
            "features"
          ]
        }
      ]
    }
  }
}
